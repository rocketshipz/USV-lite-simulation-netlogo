  <experiments>
    <experiment name="calm-baseline" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>done?</exitCondition>
      <metrics>
        <metric>done?</metric>
        <metric>finish-tick</metric>
        <metric>trips</metric>
        <metric>delivered-kg</metric>
        <metric>total-generated-kg</metric>
        <metric>sc-wait-ticks</metric>
        <metric>sc-patrol-ticks</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="0" step="1" last="99"></steppedValueSet>
        <enumeratedValueSet variable="wave-strength">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wakes?">
          <value value="false"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="wave-strength" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>done?</exitCondition>
      <metrics>
        <metric>done?</metric>
        <metric>finish-tick</metric>
        <metric>sc-wait-ticks</metric>
        <metric>sc-patrol-ticks</metric>
        <metric>missed-sightings</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="0" step="1" last="99"></steppedValueSet>
        <enumeratedValueSet variable="wave-strength">
          <value value="0"></value>
          <value value="0.5"></value>
          <value value="1"></value>
          <value value="1.5"></value>
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="wakes?">
          <value value="false"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="sensor-radius-vs-patrol" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>done?</exitCondition>
      <metrics>
        <metric>done?</metric>
        <metric>finish-tick</metric>
        <metric>count plastics</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="0" step="1" last="99"></steppedValueSet>
        <enumeratedValueSet variable="sensor-radius">
          <value value="10"></value>
          <value value="15"></value>
          <value value="20"></value>
          <value value="25"></value>
          <value value="30"></value>
          <value value="40"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="patrol-mode">
          <value value="&quot;lawnmower (from sensor radius)&quot;"></value>
          <value value="&quot;fixed waypoints (original)&quot;"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="capacity" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>done?</exitCondition>
      <metrics>
        <metric>done?</metric>
        <metric>finish-tick</metric>
        <metric>trips</metric>
        <metric>sc-wait-ticks</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="0" step="1" last="99"></steppedValueSet>
        <enumeratedValueSet variable="sc-capacity">
          <value value="1"></value>
          <value value="2"></value>
          <value value="3"></value>
          <value value="4"></value>
          <value value="5"></value>
          <value value="6"></value>
          <value value="8"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
