<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[; =====================================================================
;  USV Marine Plastic Collection - LITE (Scenario 1) + Wave CA
;  TEB2103 Modelling and Simulation - September 2026
;
;  Hybrid model:
;   * Agent-based layer: one SC-USV and one T-USV collect static plastic
;     (Scenario 1: normal collection, ported from main.py)
;   * Cellular automaton layer: every water patch holds a surface
;     height h. All patches update at once from their 8 neighbours
;     using a discrete 2D wave equation, so ripples spread, interfere
;     and fade.
;   * Coupling (CA -> agents): the local sea state slows the USVs,
;     most when heading into the waves; climbing a wave face slows
;     them and running down one speeds them up; plastic sitting in a
;     trough can be hidden behind the crest in front of it.
;   * Coupling (agents -> CA): moving USVs leave wakes (optional).
;   * Boat effects (visual only, switch boat-effects?): shadow, bobbing,
;     roll, pitch and bow spray, so the waves read in a top-down view.
; =====================================================================

globals [
  base-x base-y
  total-generated-kg delivered-kg delivered-items trips
  done? finish-tick
  sc-wait-ticks           ; SC-USV ticks spent waiting for the T-USV
  sc-patrol-ticks         ; SC-USV ticks spent patrolling with no target
  missed-sightings        ; in-range items hidden by waves (counted per tick)
  wave-time               ; clock of the wave CA (also runs during warm-up)
  phase-1 phase-2         ; random starting phases of the two swell trains
]

; breeds declared later are drawn on top: shadows sit under everything
breed [shadows shadow]    ; visual only: one per USV
breed [plastics plastic]
breed [sprays spray]      ; visual only: bow spray puffs
breed [scs sc]            ; Search-and-Collect USV
breed [tus tu]            ; Transport USV

turtles-own [
  load-items load-kg state
  ; boat-effects state (visual only)
  course                  ; real direction of travel; heading may be tilted for display
  roll roll-vel           ; displayed rocking angle and its rate of change
  my-shadow               ; this USV's shadow agent
  spray-cooldown          ; ticks until the next spray puff is allowed
]
sprays-own [ life ]
plastics-own [ weight ]
scs-own [ target waypoints wp-index ]
patches-own [ h old-h new-h energy ]   ; wave CA state: height now, last tick, next; energy = running mean of h^2

; ---------------------------------------------------------------------
; Constants
; ---------------------------------------------------------------------
to-report plastic-weight-min report 1.0 end
to-report plastic-weight-max report 5.0 end
to-report wave-c2 report 0.5 end        ; wave speed squared (stable up to ~0.8)
to-report wave-damping report 0.98 end  ; energy kept per tick
to-report gusts-per-tick report 3 end   ; short wind gusts (chop) per tick
to-report wind-forcing report 0.015 end ; how hard the wind pumps the swell each tick
to-report chop-share report 0.25 end    ; size of a chop gust relative to wave-strength
; speed at which crests travel across this CA, in patches per tick.
; For smooth waves (mean of 8 neighbours - h) is about 3/8 of the Laplacian,
; so the effective c^2 is wave-c2 * 3/8.
to-report wave-celerity report sqrt (wave-c2 * 3 / 8) end

; boat-effects constants (visual only)
to-report boat-size report 5 end
to-report sun-direction report 135 end  ; shadows fall towards the south-east
to-report bob-gain report 0.05 end      ; size change per unit of wave height
to-report roll-gain report 30 end       ; degrees of roll per unit of cross-slope
to-report pitch-gain report 0.05 end       ; shadow shift (m) per unit of slope along the hull
to-report spray-slope report 0.09 end   ; how steep a face must be to throw spray

; =====================================================================
; SETUP
; =====================================================================
to setup
  clear-all
  if fixed-seed? [ random-seed seed ]
  set base-x 10
  set base-y 10
  set done? false

  ask patches [ set h 0 set old-h 0 set new-h 0 ]
  set wave-time 0
  set phase-1 random-float 360
  set phase-2 random-float 360

  create-scs 1 [
    set shape "sc-usv"  set color red  set size boat-size
    setxy 50 50
    set state "searching"
    set target nobody
    set waypoints build-waypoints
    set wp-index 0
    init-boat-visuals "sc-usv-shadow"
    if show-trails? [ pen-down ]
  ]

  create-tus 1 [
    set shape "tu-usv"  set color lime  set size boat-size
    setxy base-x base-y
    set state "idle"
    init-boat-visuals "tu-usv-shadow"
    if show-trails? [ pen-down ]
  ]

  create-plastics num-plastics [
    set shape "circle"  set color yellow
    set weight precision (plastic-weight-min + random-float (plastic-weight-max - plastic-weight-min)) 1
    set size 0.8 + 0.35 * weight
    setxy (spawn-margin + random-float (max-pxcor - 2 * spawn-margin))
          (spawn-margin + random-float (max-pycor - 2 * spawn-margin))
  ]
  set total-generated-kg sum [weight] of plastics

  ; let the sea build up before the USVs start, so waves are already present at tick 0
  repeat 150 [ update-waves ]

  recolor-patches
  update-boat-visuals
  ask patch base-x (base-y - 3) [ set plabel "BASE" set plabel-color white ]
  reset-ticks
end

; Patrol route. Lawnmower lanes are at most 1.8 x sensor radius apart,
; so every point of the area is within sensor range of some lane.
to-report build-waypoints
  if patrol-mode = "fixed waypoints (original)" [
    report [[20 20] [20 80] [50 80] [50 20] [80 20] [80 80]]
  ]
  let w world-width
  let n max list 1 (ceiling (w / (1.8 * sensor-radius)))
  let s w / n
  let y-lo 3
  let y-hi max-pycor - 3
  let pts []
  foreach range n [ k ->
    let x -0.5 + s * (k + 0.5)
    ifelse k mod 2 = 0
      [ set pts lput (list x y-lo) pts  set pts lput (list x y-hi) pts ]
      [ set pts lput (list x y-hi) pts  set pts lput (list x y-lo) pts ]
  ]
  report pts
end

; =====================================================================
; GO
; =====================================================================
to go
  if done? [ stop ]
  if ticks >= max-ticks [ stop ]
  update-waves                       ; 1. CA layer
  ; undo the display tilt so the agents work with their real course
  ask (turtle-set scs tus) [ set heading course ]
  ask (turtle-set scs tus) [         ; 2. agent layer, random order
    ifelse breed = scs [ sc-step ] [ tu-step ]
  ]
  ask (turtle-set scs tus) [ set course heading ]
  recolor-patches
  update-boat-visuals                ; 3. visual only, after all decisions
  tick
  check-done
end

to check-done
  if (not any? plastics) and (all? scs [load-items = 0]) and (all? tus [state = "idle"]) [
    set done? true
    set finish-tick ticks
    ask scs [ set state "completed" set label "done" ]
  ]
end

; =====================================================================
; WAVE CELLULAR AUTOMATON
;   Rule for every cell (patch), applied to all cells at the same time:
;     new-h = (2h - old-h + c^2 * (mean of 8 neighbours' h - h)) * damping
;   This is a discrete 2D wave equation: disturbances travel, interfere
;   and fade.
;
;   Wind input (what makes crests and troughs instead of round ripples):
;   1. Swell: the wind pushes the surface a little every tick in the
;      pattern of two long plane waves travelling towards wave-heading
;      (the second is shorter, 25 degrees off and half as strong, which
;      breaks the crests into irregular, realistic lines). The push moves
;      at the CA's own wave speed, so the CA amplifies it into swell.
;   2. Chop: 3 short gusts per tick, each a 7-patch line lying along the
;      crest direction, add small irregular wavelets.
; =====================================================================
to update-waves
  set wave-time wave-time + 1
  if wave-strength > 0 [
    ; swell forcing (NetLogo trig is in degrees; heading 0 = north)
    let k1 360 / wavelength
    let k2 360 / (0.7 * wavelength)
    let d1 wave-heading
    let d2 wave-heading + 25
    let w1 wave-celerity * k1
    let w2 wave-celerity * k2
    let t wave-time
    let f wind-forcing * wave-strength
    ask patches [
      set h h + f * ( sin (k1 * (pxcor * sin d1 + pycor * cos d1) - w1 * t + phase-1)
                    + 0.5 * sin (k2 * (pxcor * sin d2 + pycor * cos d2) - w2 * t + phase-2) )
    ]
    ; chop: short gusts shaped like a piece of crest
    repeat gusts-per-tick [
      let push chop-share * wave-strength * one-of [1 -1]
      ask one-of patches [
        set h h + push
        foreach [1 2 3] [ i ->
          let a patch-at-heading-and-distance (wave-heading + 90) i
          let b patch-at-heading-and-distance (wave-heading - 90) i
          if a != nobody [ ask a [ set h h + push ] ]
          if b != nobody [ ask b [ set h h + push ] ]
        ]
      ]
    ]
  ]
  ; the CA rule itself
  ask patches [
    set new-h (2 * h - old-h + wave-c2 * (mean [h] of neighbors - h)) * wave-damping
  ]
  ask patches [
    set old-h h
    set h new-h
    ; local sea state: running mean of h^2 over roughly the last 50 ticks
    set energy 0.98 * energy + 0.02 * h * h
  ]
end

; ---------------------------------------------------------------------
; What a USV feels from the waves (turtle reporters)
; ---------------------------------------------------------------------
; local sea state: RMS wave height here over recent ticks. This does not
; flip between crest and trough, it measures how rough this area is.
to-report sea-state
  report sqrt [energy] of patch-here
end

; 0 = following sea (moving with the waves), 1 = head sea (straight into them)
to-report head-sea-factor
  report (1 - cos (subtract-headings heading wave-heading)) / 2
end

; rise of the surface per metre along the USV's heading
; (+ = climbing a wave face, - = running down one)
to-report wave-slope
  let ahead patch-at-heading-and-distance heading 1
  let behind patch-at-heading-and-distance (heading + 180) 1
  if ahead = nobody or behind = nobody [ report 0 ]
  report ([h] of ahead - [h] of behind) / 2
end

; =====================================================================
; SC-USV  (SEARCHING -> WAITING -> SEARCHING ... -> COMPLETED)
; =====================================================================
to sc-step
  set label (word load-items "/" sc-capacity)
  if state = "completed" [ stop ]
  if state = "waiting" [
    set sc-wait-ticks sc-wait-ticks + 1
    stop
  ]
  if not any? plastics [
    ifelse load-items > 0 [ set state "waiting" ] [ set state "completed" ]
    stop
  ]

  ; detect: items in range are seen unless a wave hides them this tick
  if target = nobody [
    let in-range plastics in-radius sensor-radius
    let seen in-range with [ random-float 1 < detect-probability ]
    set missed-sightings missed-sightings + (count in-range - count seen)
    if any? seen [ set target min-one-of seen [ distance myself ] ]
  ]

  ifelse target != nobody [
    ; once locked on, the target is tracked at close range
    if move-toward ([xcor] of target) ([ycor] of target) speed-sc [ collect target ]
  ] [
    set sc-patrol-ticks sc-patrol-ticks + 1
    let wp item wp-index waypoints
    if move-toward (first wp) (last wp) speed-sc [
      set wp-index (wp-index + 1) mod length waypoints
    ]
  ]
end

; plastic reporter: chance of being seen this tick, lower in rough water
to-report detect-probability
  ; an item in a trough is shadowed by the crest in front of it;
  ; an item on a crest stands out and is always seen
  report max list 0 (1 - 2 * wave-hiding * max list 0 (0 - [h] of patch-here))
end

to collect [p]
  set load-items load-items + 1
  set load-kg load-kg + [weight] of p
  ask p [ die ]
  set target nobody
  if load-items >= sc-capacity [ set state "waiting" ]
end

; speeds for the plots, always worked out on the real course
to-report sc-speed
  report travel-speed speed-sc
end

to-report tu-speed
  report travel-speed speed-t
end

to-report travel-speed [v0]
  let shown heading
  set heading course
  let v usv-speed v0
  set heading shown
  report v
end

; does the SC-USV need the T-USV?
to-report needs-pickup?
  if state = "waiting" [ report true ]
  report early-dispatch? and state = "searching" and load-items > 0 and load-items >= sc-capacity - 1
end

; =====================================================================
; T-USV  (IDLE -> RETRIEVING -> RETURNING -> IDLE)
; =====================================================================
to tu-step
  set label precision load-kg 1
  let sc-usv one-of scs
  if state = "idle" and [needs-pickup?] of sc-usv [ set state "retrieving" ]

  ifelse state = "retrieving" [
    ifelse [state] of sc-usv = "completed" [
      set state "returning"
    ] [
      let arrived? move-toward ([xcor] of sc-usv) ([ycor] of sc-usv) speed-t
      ; with early dispatch the T-USV escorts the SC-USV until it is full
      if arrived? and [state] of sc-usv = "waiting" [ take-load sc-usv ]
    ]
  ] [
    if state = "returning" [
      if move-toward base-x base-y speed-t [
        if load-items > 0 [ set trips trips + 1 ]
        set delivered-kg delivered-kg + load-kg
        set delivered-items delivered-items + load-items
        set load-kg 0
        set load-items 0
        set state "idle"
      ]
    ]
  ]
end

to take-load [s]
  set load-kg load-kg + [load-kg] of s
  set load-items load-items + [load-items] of s
  ask s [
    set load-kg 0
    set load-items 0
    set state ifelse-value any? plastics [ "searching" ] [ "completed" ]
  ]
  set state "returning"
end

; =====================================================================
; MOVEMENT (shared by both USVs)
;   speed = v0 x slope-f / ((1 + drag x load) x (1 + wave-drag x sea x heading-f))
;   sea       = local RMS wave height (sea-state)
;   heading-f = 0.3 in a following sea, 1.0 in a head sea
;   slope-f   = 1 - surf-effect x slope, kept between 0.6 and 1.4
;               (slower climbing a wave face, faster running down it)
;   floored at min-speed
; =====================================================================
to-report usv-speed [v0]
  let load-f 1 + drag-factor * load-kg
  let sea-f 1 + wave-drag * sea-state * (0.3 + 0.7 * head-sea-factor)
  let slope-f max list 0.6 (min list 1.4 (1 - surf-effect * wave-slope))
  report max list min-speed (v0 * slope-f / (load-f * sea-f))
end

; turn towards (tx, ty), then move one step at the speed for that heading;
; report true on arrival
to-report move-toward [tx ty v0]
  let d distancexy tx ty
  if d > 0 [ facexy tx ty ]
  let spd usv-speed v0
  if d <= spd [
    setxy tx ty
    report true
  ]
  fd spd
  if wakes? [ ask patch-here [ set h h - wake-strength ] ]   ; agents -> CA
  report false
end

; =====================================================================
; DISPLAY AND REPORTERS
; =====================================================================
to recolor-patches
  let r 2 * max list 0.5 wave-strength
  ask patches [ set pcolor water-color blue h r ]
  if show-sensor? [
    ask scs [ ask patches in-radius sensor-radius [ set pcolor water-color cyan h r ] ]
  ]
  ask patches with [ distancexy base-x base-y < 2.5 ] [ set pcolor gray ]
end

; wave height -> shade of a hue: deepest trough = dark, highest crest = near white
to-report water-color [base hh r]
  let t (hh + r) / (2 * r)          ; 0 = deepest trough, 1 = highest crest
  set t max list 0 (min list 1 t)
  report (base - 2.7) + t * 7.5       ; blue: 102 (dark blue) to 109.5 (near white)
end

;=====================================================================
; BOAT EFFECTS (visual only)
;   None of this changes speed, detection or decisions, and it uses no
;   random numbers, so a run gives the same results with it on or off.
;   1. Shadow: offset towards the sun-facing side; further away when the
;      boat is lifted on a crest, tucked in when it sits in a trough.
;   2. Bobbing: the icon grows slightly on crests, shrinks in troughs.
;   3. Roll: the icon rocks with the water slope across the hull, using a
;      damped spring so it overshoots and settles like a real hull.
;   4. Pitch: the shadow shifts forward when the bow rises (climbing a
;      face) and back when it drops (running down one).
;   5. Bow spray: a white puff when the boat climbs a steep face in a
;      head sea.
;=====================================================================
to init-boat-visuals [shadow-shape]
  set course heading
  set roll 0
  set roll-vel 0
  set spray-cooldown 0
  hatch-shadows 1 [
    let s self
    set shape shadow-shape
    set color [0 0 0 90]
    set label ""
    pen-up
    ask myself [ set my-shadow s ]
  ]
end

to update-boat-visuals
  ifelse boat-effects? [
    ask (turtle-set scs tus) [ boat-visuals ]
    ask shadows [ show-turtle ]
  ] [
    ask (turtle-set scs tus) [ set heading course  set size boat-size ]
    ask shadows [ hide-turtle ]
  ]
  ask sprays [
    set life life - 1
    set size size + 0.4
    set color lput (30 * life) [255 255 255]
    if life <= 0 [ die ]
  ]
end

to boat-visuals   ; USV procedure
  set heading course
  let hh [h] of patch-here
  let along wave-slope                      ; + = bow rising
  ; slope across the hull (+ = starboard side higher)
  let cross 0
  let stbd patch-at-heading-and-distance (course + 90) 1.5
  let port patch-at-heading-and-distance (course - 90) 1.5
  if stbd != nobody and port != nobody [ set cross ([h] of stbd - [h] of port) / 3 ]

  ; 3. roll: damped spring towards the angle the water pushes it to
  set roll-vel 0.75 * roll-vel + 0.3 * (roll-gain * cross - roll)
  set roll max list -20 (min list 20 (roll + roll-vel))

  ; 5. bow spray when climbing a steep face into the waves
  if spray-cooldown > 0 [ set spray-cooldown spray-cooldown - 1 ]
  if spray-cooldown = 0 and along > spray-slope and head-sea-factor > 0.6 and state != "waiting" and state != "completed" and state != "idle" [
    set spray-cooldown 5
    hatch-sprays 1 [
      set shape "spray"
      set color [255 255 255 180]
      set size 2
      set label ""
      set life 6
      pen-up
      if can-move? (boat-size * 0.5) [ fd boat-size * 0.5 ]
    ]
  ]

  ; 2. bobbing
  set size boat-size * (1 + bob-gain * (max list -1.5 (min list 1.5 hh)))

  ; 1 + 4. shadow position: sun offset grows with height, pitch shifts it fore/aft
  let lift max list 0.15 (min list 1.8 (0.7 + 0.45 * hh))
  let fwd pitch-gain * along
  let sx clamp-x (xcor + lift * sin sun-direction + fwd * sin course)
  let sy clamp-y (ycor + lift * cos sun-direction + fwd * cos course)
  let shown-heading course + roll
  let sz size
  ask my-shadow [
    setxy sx sy
    set heading shown-heading
    set size sz
  ]

  set heading shown-heading                 ; display only; reset at the start of next tick
end

to-report clamp-x [x] report max list (min-pxcor - 0.49) (min list (max-pxcor + 0.49) x) end
to-report clamp-y [y] report max list (min-pycor - 0.49) (min list (max-pycor + 0.49) y) end

to-report mean-wave-height
  report mean [abs h] of patches
end

to-report mass-accounted
  report delivered-kg + sum [load-kg] of (turtle-set scs tus) + sum [weight] of plastics
end

to-report sc-idle-pct
  if ticks = 0 [ report 0 ]
  report 100 * sc-wait-ticks / ticks
end

to-report sc-patrol-pct
  if ticks = 0 [ report 0 ]
  report 100 * sc-patrol-ticks / ticks
end]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="604" showTickCounter="true" patchSize="6.0" fontSize="10" wrappingAllowedY="false" width="604" tickCounterLabel="ticks" maxPycor="99" updateMode="1" maxPxcor="99" minPxcor="0"></view>
    <button x="10" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="70" y="10" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="65">go</button>
    <button x="140" y="10" height="40" disableUntilTicks="true" forever="false" kind="Observer" width="60" display="step">go</button>
    <slider x="10" step="1" y="57" max="60" width="190" display="num-plastics" height="50" min="1" direction="Horizontal" default="15.0" variable="num-plastics"></slider>
    <slider x="10" step="1" y="112" max="10" width="190" display="sc-capacity" height="50" min="1" direction="Horizontal" default="3.0" variable="sc-capacity" units="items"></slider>
    <slider x="10" step="1" y="167" max="50" width="190" display="sensor-radius" height="50" min="5" direction="Horizontal" default="25.0" variable="sensor-radius" units="m"></slider>
    <slider x="10" step="0.1" y="222" max="4" width="190" display="speed-sc" height="50" min="0.5" direction="Horizontal" default="1.5" variable="speed-sc" units="m/tick"></slider>
    <slider x="10" step="0.1" y="277" max="5" width="190" display="speed-t" height="50" min="0.5" direction="Horizontal" default="2.0" variable="speed-t" units="m/tick"></slider>
    <slider x="10" step="0.01" y="332" max="0.3" width="190" display="drag-factor" height="50" min="0" direction="Horizontal" default="0.08" variable="drag-factor" units="/kg"></slider>
    <slider x="10" step="0.1" y="387" max="1" width="190" display="min-speed" height="50" min="0.1" direction="Horizontal" default="0.3" variable="min-speed"></slider>
    <slider x="10" step="1" y="442" max="20" width="190" display="spawn-margin" height="50" min="0" direction="Horizontal" default="5.0" variable="spawn-margin" units="m"></slider>
    <slider x="10" step="100" y="497" max="5000" width="190" display="max-ticks" height="50" min="500" direction="Horizontal" default="3000.0" variable="max-ticks"></slider>
    <chooser x="10" y="552" height="60" variable="patrol-mode" current="0" width="190" display="patrol-mode">
      <choice type="string" value="lawnmower (from sensor radius)"></choice>
      <choice type="string" value="fixed waypoints (original)"></choice>
    </chooser>
    <switch x="10" y="617" height="40" on="false" variable="early-dispatch?" width="190" display="early-dispatch?"></switch>
    <switch x="10" y="662" height="40" on="true" variable="show-sensor?" width="190" display="show-sensor?"></switch>
    <switch x="10" y="707" height="40" on="false" variable="show-trails?" width="190" display="show-trails?"></switch>
    <switch x="10" y="752" height="40" on="false" variable="fixed-seed?" width="190" display="fixed-seed?"></switch>
    <slider x="10" step="1" y="797" max="99" width="190" display="seed" height="50" min="0" direction="Horizontal" default="0.0" variable="seed"></slider>
    <slider x="825" step="0.1" y="10" max="2" width="185" display="wave-strength" height="50" min="0" direction="Horizontal" default="1.3" variable="wave-strength"></slider>
    <slider x="825" step="1" y="65" max="359" width="185" display="wave-heading" height="50" min="0" direction="Horizontal" default="45.0" variable="wave-heading" units="deg"></slider>
    <slider x="825" step="1" y="120" max="40" width="185" display="wavelength" height="50" min="10" direction="Horizontal" default="20.0" variable="wavelength" units="m"></slider>
    <slider x="825" step="0.05" y="175" max="1" width="185" display="wave-drag" height="50" min="0" direction="Horizontal" default="0.3" variable="wave-drag"></slider>
    <slider x="825" step="0.1" y="230" max="1.5" width="185" display="surf-effect" height="50" min="0" direction="Horizontal" default="0.8" variable="surf-effect"></slider>
    <slider x="825" step="0.05" y="285" max="1" width="185" display="wave-hiding" height="50" min="0" direction="Horizontal" default="0.4" variable="wave-hiding"></slider>
    <switch x="825" y="340" height="40" on="true" variable="wakes?" width="185" display="wakes?"></switch>
    <slider x="825" step="0.05" y="385" max="1" width="185" display="wake-strength" height="50" min="0" direction="Horizontal" default="0.6" variable="wake-strength"></slider>
    <monitor x="825" precision="0" y="445" height="60" fontSize="11" width="100" display="plastics left">count plastics</monitor>
    <monitor x="930" precision="0" y="445" height="60" fontSize="11" width="100" display="trips">trips</monitor>
    <monitor x="825" precision="1" y="510" height="60" fontSize="11" width="100" display="generated kg">total-generated-kg</monitor>
    <monitor x="930" precision="1" y="510" height="60" fontSize="11" width="100" display="delivered kg">delivered-kg</monitor>
